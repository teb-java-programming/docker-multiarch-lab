{
  "info": {
    "_postman_id": "7d0c2f8e-8a52-4e0d-9d8d-3c2c6d8f1a21",
    "name": "docker-multiarch-lab",
    "description": "API validation for the docker-multiarch-lab application and WireMock.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/service"
    },
    {
      "key": "wiremockUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Orders",
      "item": [
        {
          "name": "POST valid order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUST-123\",\n  \"productId\": \"PROD-123\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Response contains an order ID\", function () {",
                  "    pm.expect(body.id).to.exist;",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"orderId\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET existing order",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Returned order has the expected customer\", function () {",
                  "    pm.expect(body.customerId).to.eql(\"CUST-123\");",
                  "});",
                  "",
                  "pm.test(\"Returned order has the expected product\", function () {",
                  "    pm.expect(body.productId).to.eql(\"PROD-123\");",
                  "});",
                  "",
                  "pm.test(\"Returned order has the expected quantity\", function () {",
                  "    pm.expect(body.quantity).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST invalid quantity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUST-123\",\n  \"productId\": \"PROD-123\",\n  \"quantity\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST invalid customer and product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUST-999\",\n  \"productId\": \"PROD-999\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET nonexistent order",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/orders/999999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "999999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "WireMock",
      "item": [
        {
          "name": "GET WireMock mappings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{wiremockUrl}}/__admin/mappings",
              "host": [
                "{{wiremockUrl}}"
              ],
              "path": [
                "__admin",
                "mappings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"WireMock mappings response contains mappings\", function () {",
                  "    pm.expect(body.mappings).to.be.an(\"array\");",
                  "    pm.expect(body.mappings.length).to.be.above(0);",
                  "});",
                  "",
                  "const responseText = pm.response.text();",
                  "",
                  "pm.test(\"Valid customer/product mapping is present\", function () {",
                  "    pm.expect(responseText).to.include(\"/validation/customers/\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}